<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MainActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/titulo"
        android:textColor="@color/principal"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Etiqueta y spinner de magnitud -->
    <TextView
        android:id="@+id/tvLabelMagnitud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_magnitud"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/tvTitulo" />

    <RelativeLayout
        android:id="@+id/rlMagnitud"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/gradient_spinner"
        app:layout_constraintEnd_toEndOf="@+id/etValor"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/tvLabelMagnitud">

        <Spinner
            android:id="@+id/spMagnitud"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>
    <!-- Etiqueta y campo del valor -->
    <TextView
        android:id="@+id/tvLabelValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_valor"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/rlMagnitud" />

    <EditText
        android:id="@+id/etValor"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/gradient_spinner"
        android:hint="@string/hint_valor"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/texto"
        android:textColorHint="@color/hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLabelValor" />

    <!-- Etiqueta y spinner de origen -->
    <TextView
        android:id="@+id/tvLabelOrigen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_origen"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/etValor" />

    <!-- El RelativeLayout lleva el borde y el spinner va dentro con match_parent (diapositiva 12) -->
    <RelativeLayout
        android:id="@+id/rlOrigen"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/gradient_spinner"
        app:layout_constraintEnd_toEndOf="@+id/etValor"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/tvLabelOrigen">

        <Spinner
            android:id="@+id/spOrigen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>

    <!-- Etiqueta y spinner de destino -->
    <TextView
        android:id="@+id/tvLabelDestino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_destino"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/rlOrigen" />

    <RelativeLayout
        android:id="@+id/rlDestino"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/gradient_spinner"
        app:layout_constraintEnd_toEndOf="@+id/etValor"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/tvLabelDestino">

        <Spinner
            android:id="@+id/spDestino"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>

    <!-- Botón -->
    <Button
        android:id="@+id/btnConvertir"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:text="@string/btn_convertir"
        android:textSize="18sp"
        app:backgroundTint="@color/principal"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="@+id/etValor"
        app:layout_constraintStart_toStartOf="@+id/etValor"
        app:layout_constraintTop_toBottomOf="@+id/rlDestino" />

    <!-- Resultado -->
    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/tv_resultado"
        android:textColor="@color/principal"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnConvertir" />

</androidx.constraintlayout.widget.ConstraintLayout>